# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DATABASE_URL="mysql://:`DB_PASSWORD`@`DB_HOST`:`DB_PORT`/`DB_NAME`"
# Replace na lang yung may mga backticks.
# Example: "mysql://root:paszw0rd@localhost:3306/qcu_msc_central_portal"

# Seed Configuration (prisma/seed.ts — `npx prisma db seed`)
# Optional; defaults are shown and used when a var is unset. The seed refuses
# to run on production/main regardless of these values.
# Dataset sizes must be positive integers, with member/applicant/irregular
# counts <= SEED_USER_COUNT.
SEED_USER_COUNT=300                # total bulk users (each gets one account)
SEED_MEMBER_USER_COUNT=75          # subset promoted to MEMBER role (approved applicants)
SEED_APPLICANT_COUNT=300           # applicant records (one per user)
SEED_DRAFT_COUNT=150               # application drafts
SEED_IRREGULAR_COUNT=5             # students enrolled earlier than the standard cohort
SEED_ADMIN_HR_COUNT=5              # ADMIN_HR admins
SEED_ADMIN_LOGISTICS_COUNT=5       # ADMIN_LOGISTICS admins
SEED_USER_PASSWORD="SeedPass123!"  # sign-in password for bulk users
SEED_ADMIN_PASSWORD="AdminPass123!" # sign-in password for admin accounts

# Better Auth Configuration
BETTER_AUTH_SECRET="0fdf8f33cee214997ff9fe5d3179d0a90883c7fed0958a250328cdf52a015a80"
BETTER_AUTH_URL="http://localhost:5000"

# OCR & Image Storage
OCR_MAX_FAILURES=3

# Application Draft & Resume
# Time-to-live of an in-progress draft (hours) — expired drafts are deleted
# lazily at the next OCR scan, allowing a fresh application.
DRAFT_TTL_HOURS=168
# Minimum minutes between resume-link emails for the same draft (anti-spam).
RESUME_EMAIL_COOLDOWN_MINUTES=30
# Resume-link JWT expiry in minutes. Aligned with the cooldown so a rescan
# always produces a fresh, valid link.
RESUME_TOKEN_EXPIRY_MINUTES=30

# Password reset
# Time-to-live of a password-reset link emailed to the user (minutes).
# The link is single-use and invalidates all active sessions once consumed.
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30

# OAuth — Google (optional, leave empty to disable)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OAuth — GitHub (optional, leave empty to disable)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Frontend URL (for CORS and CSRF protection)
# Must match the port the frontend dev server serves on (8080).
FRONTEND_URL="http://localhost:8080"
ADMIN_FRONTEND_URL="http://localhost:8081"

# Azure Storage Configuration
# Blob account holding the `ocr` and `documents` containers.
AZURE_STORAGE_ACCOUNT_NAME=""

# Sentry Observability Configuration
SENTRY_DSN=""


# Azure Authentication (Service Principal) — LOCAL DEVELOPMENT ONLY.
# Set all three together or none; ask the infra owner for the values.
# Deployed apps use their managed identity instead, so do not set the
# secret/tenant there. Blob uploads fail without these — under
# NODE_ENV=development the backend falls back to ./uploads, otherwise it
# errors on purpose.
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
AZURE_TENANT_ID=""

# Email Provider (RESEND for production, SMTP for development)
# EMAIL_PROVIDER=RESEND
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL=no-reply@msc-qcu.tech

# SMTP Config (development — uncomment and fill to use SMTP)
EMAIL_PROVIDER=SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-email-password-or-app-password" # Get yours from https://myaccount.google.com/apppasswords
SMTP_FROM_NAME=Microsoft Student Community
SMTP_FROM_EMAIL="your-email@gmail.com"