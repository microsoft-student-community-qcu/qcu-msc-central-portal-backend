datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

// ============================================================================
// ENUMS
// ============================================================================

// User role enumeration for role-based access control.
// V1 roles: APPLICANT, MEMBER, ADMIN_HR, ADMIN_LOGISTICS (PRD-V1).
// V2 (PRD-V2) adds domain admins + SUPERADMIN; ADMIN_CORE was intentionally
// removed — its permissions are folded into the heads and SUPERADMIN.
// SUPERADMIN passes every require* guard via role inheritance.
enum UserRole {
  APPLICANT
  MEMBER
  ADMIN_HR
  ADMIN_LOGISTICS
  SUPERADMIN
  ADMIN_FINANCE
  ADMIN_FINANCE_HEAD
  ADMIN_LOGISTICS_HEAD
  STARTUP_DEV
}

// Applicant status enumeration for tracking recruitment pipeline.
enum ApplicantStatus {
  APPROVED
  PENDING_REVIEW
  FOR_INTERVIEW
  REJECTED
  CANCELLED
  RESUBMIT
}

// Gender enumeration for membership application.
enum Gender {
  MALE
  FEMALE
  LGBTQIA
  PREFER_NOT_TO_SAY
}

// Office enumeration for the office a member is applying to join.
enum Office {
  SECRETARIAT_OFFICE
  RELATIONS_OFFICE
  FINANCE_OFFICE
  LOGISTICS_OFFICE
  CREATIVES_OFFICE
  MANAGEMENT_AND_DEVELOPMENT_OFFICE
  STARTUP_DEVELOPERS_OFFICE
}

// Campus enumeration for QCU campuses.
enum Campus {
  SAN_BARTOLOME_MAIN
  SAN_FRANCISCO
  BATASAN
}

// Event visibility and access control type.
enum EventType {
  PUBLIC
  MEMBERS_ONLY
}

// Registration lifecycle status for event registrations.
// Supports Path A (auto-approve) and Path B (manual review) flows per PRD-V1.
enum RegistrationStatus {
  APPROVED
  PENDING_REVIEW
  REJECTED
  CANCELLED
}

// Sponsorship inquiry status enumeration for Relations Office tracking.
// Supports PRD-V1 Section 2: Guest (External) can submit sponsorship inquiries.
enum SponsorshipStatus {
  NEW
  CONTACTED
  CLOSED
}

// ── Merch Pre-Orders (V2 Module 04 — Finance) ───────────────────────────────

// Catalog item lifecycle. ARCHIVED hides the item from the public catalog
// while preserving historical order records.
enum MerchItemStatus {
  ACTIVE
  ARCHIVED
}

// Order lifecycle for the offline GCash pre-order flow (PRD-V2 Finance Flows 2–5).
// Stock is only decremented on CONFIRMED; it is never reserved earlier
// (see issue #178 for the oversell trade-off this creates).
enum MerchOrderStatus {
  AWAITING_PAYMENT // Order created; student has not submitted payment proof yet
  PENDING_VERIFICATION // Proof submitted; awaiting finance officer review
  CONFIRMED // Payment verified; stock decremented; awaiting pickup
  PAID_AND_CLAIMED // Merch physically handed over — terminal success state
  REJECTED // Payment failed verification or duplicate reference — resubmittable
  REFUND_PENDING // Student paid but item is unfulfillable (oversold) — refund owed
  REFUNDED // Refund processed offline and recorded — terminal state
  CANCELLED // Head-cancelled (terminal); refunds handled offline
}

// Preset rejection reasons for a failed payment verification (Flow 4).
// OTHER pairs with a free-text financeNote on the order.
enum MerchRejectionReason {
  REFERENCE_NOT_FOUND
  AMOUNT_MISMATCH
  SCREENSHOT_UNCLEAR
  DUPLICATE_REFERENCE
  OUT_OF_STOCK
  OTHER
}

// Immediate automated outcome of a single payment-proof submission attempt.
// Officer verify/reject decisions live on the order (status + rejectionReason),
// not here — this only records what the automated intake did with the attempt.
enum PaymentProofResult {
  ACCEPTED // Passed the duplicate check → order moved to PENDING_VERIFICATION
  DUPLICATE_REJECTED // Reference already used elsewhere → order auto-REJECTED
}

// Officer's verification decision on a single payment-proof submission (Flow 4).
// Distinct from PaymentProofResult (the automated intake result): this records
// what the human officer did with the attempt, giving each submission its own
// outcome so the order's attempt history is auditable end-to-end.
enum PaymentProofDecision {
  PENDING // Awaiting officer review (default on intake)
  VERIFIED // Officer confirmed this submission's payment
  REJECTED // Officer rejected this submission (see rejectionReason)
}

// How an offline refund was issued (recorded for transparency, Flow: refund).
enum MerchRefundMethod {
  GCASH
  CASH
  OTHER
}

// ============================================================================
// MODELS
// ============================================================================

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  lastName      String?
  firstName     String?
  middleInitial String?
  name          String? // Full name (Better Auth standard field — constructed server-side from firstName + lastName)
  studentId     String         @unique
  emailVerified Boolean        @default(false)
  image         String?
  role          UserRole       @default(APPLICANT)
  password      String? // Optional password field (managed by Better Auth in Account table)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      Session[]
  accounts      Account[]
  registrations Registration[]
  merchOrders   MerchOrder[] // Merch pre-orders placed while authenticated (Module 04)
  applicant     Applicant? // Optional one-to-one relation to Applicant (if linked to a member)
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Applicant {
  id                        String          @id @default(uuid())
  lastName                  String          @default("")
  firstName                 String          @default("")
  middleInitial             String?
  email                     String          @unique
  college                   String
  program                   String
  section                   String
  campus                    Campus
  studentId                 String? // QCU Student ID (YY-NNNN), extracted from Zonal OCR
  dateOfBirth               DateTime
  placeOfBirth              String
  gender                    Gender
  office                    Office
  certificateOfRegistration String // Filesystem path to uploaded Certificate of Registration
  curriculumVitae           String // Filesystem path to uploaded Curriculum Vitae
  houseAddress              String
  cellphoneNumber           String
  facebookLink              String
  interestsSkillsHobbies    String          @db.Text
  organizationHistory       String          @db.Text
  portfolio                 String? // Optional — URL to portfolio
  githubOrProjectLinks      String? // Optional — URL to GitHub or project links
  previousWorksAchievements String?         @db.Text // Optional — previous works or achievements
  status                    ApplicantStatus @default(PENDING_REVIEW)
  manual_application        Boolean         @default(false) // Flagged true when OCR fails → manual upload
  idImagePath               String? // Filesystem path to uploaded Student ID image
  adminMessage              String?         @db.Text // Admin remark (used for RESUBMIT reason, etc.)
  resubmitFields            String? // Comma-separated list or JSON array of fields to resubmit
  userId                    String?         @unique // Nullable one-to-one link to User when applicant becomes a member
  user                      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
}

model Event {
  id                String         @id @default(uuid())
  title             String
  description       String?
  date              DateTime
  // Tiered registration windows — PRD-V1 Event Registration & Ticketing module.
  priorityStartDate DateTime // Members can register starting here
  generalStartDate  DateTime // Everyone can register starting here
  type              EventType      @default(PUBLIC)
  maxCapacity       Int
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  registrations     Registration[]
}

model Registration {
  id                  String             @id @default(uuid())
  eventId             String
  event               Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId              String?
  user                User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  studentId           String? // QCU Student ID from Zonal OCR (guest registrations)
  email               String
  lastName            String             @default("")
  firstName           String             @default("")
  middleInitial       String?
  status              RegistrationStatus @default(APPROVED)
  manual_registration Boolean            @default(false) // Flagged true when OCR fails → manual upload
  qrPayload           String             @unique // Unique UUID for QR code verification
  hasAttended         Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([eventId, userId]) // One registration per authenticated user per event
  @@unique([eventId, studentId]) // One registration per student ID per event (guests)
}

// Sponsorship inquiry capture — PRD-V1: Guest (External) can submit
// sponsorship inquiry forms via the landing page's "Collaborate With Us" CTA.
model SponsorshipInquiry {
  id           String            @id @default(uuid())
  email        String
  contactName  String
  contactPhone String?
  company      String
  message      String            @db.Text
  status       SponsorshipStatus @default(NEW)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

// Multi-step application draft — stores partial applicant submissions per batch step.
// Deleted after the applicant record is created on final submission (step 3).
model ApplicationDraft {
  id           String @id @default(uuid())
  currentStep  Int    @default(0)
  ocrSessionId String @unique

  lastName      String?
  firstName     String?
  middleInitial String?
  email         String?

  studentId   String?
  idImagePath String?

  dateOfBirth     DateTime?
  placeOfBirth    String?
  gender          Gender?
  cellphoneNumber String?
  houseAddress    String?
  facebookLink    String?

  college                   String?
  program                   String?
  section                   String?
  campus                    Campus?
  office                    Office?
  certificateOfRegistration String?
  curriculumVitae           String?

  interestsSkillsHobbies    String? @db.Text
  organizationHistory       String? @db.Text
  portfolio                 String?
  githubOrProjectLinks      String?
  previousWorksAchievements String? @db.Text

  manual_application    Boolean?
  lastResumeEmailSentAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// Global system toggles — V2 Super Admin Settings Hub (Module 01 / M0).
// Governs subsystem availability across the entire portal (e.g. registration
// windows, merch shop, maintenance mode). Written only by SUPERADMIN via
// PATCH /api/v2/admin/settings; every change is audit-logged.
model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique // Whitelisted key, e.g. events_registration_open
  value       Json // Boolean state of the toggle (JSON so future types are possible)
  description String?
  updatedById String? // User id of the last editor (no FK — survives user deletion)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([updatedAt])
}

// Append-only, tamper-evident audit trail of administrative actions — V2
// Super Admin Settings Hub (Module 01 / M0). Each row carries the hash of the
// previous row (hash chain); integrity is verified on read. No update/delete
// paths exist for this table. actorId has no FK on purpose so audit rows
// survive user deletion.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String? // User id who performed the action (null = system)
  action     String // e.g. ROLE_CHANGE, SETTING_UPDATE, SYSTEM_MAINTENANCE
  entityType String // e.g. "USER", "SYSTEM_SETTING"
  entityId   String?
  details    Json? // Action-specific payload (never contains secrets)
  ipAddress  String?
  prevHash   String? // Hash of the previous log row (hash chain linkage)
  hash       String // HMAC-SHA256 of this row's canonical payload
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([actorId])
  @@index([action])
}

// A merch catalog product (V2 Module 04). Photos are stored as a JSON array of
// Blob URLs (MySQL has no scalar string arrays). Price is Decimal to avoid
// floating-point money errors. Variants hold the actual sellable stock.
model MerchItem {
  id                String          @id @default(uuid())
  name              String
  description       String          @db.Text
  price             Decimal         @db.Decimal(10, 2) // PHP, e.g. 350.00
  status            MerchItemStatus @default(ACTIVE)
  photos            Json            @default("[]") // Array of Blob image URLs (front/back/detail)
  lowStockThreshold Int             @default(10) // Variants at/below this show a "Low Stock" flag
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  variants          MerchVariant[]

  @@index([status])
}

// A sellable size/variant of a MerchItem with its own stock counter.
// Stock is decremented only when an order reaches CONFIRMED (Flow 4).
model MerchVariant {
  id        String       @id @default(uuid())
  itemId    String
  item      MerchItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  label     String // e.g. "S", "M", "L", "XL", "One Size"
  stock     Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  orders    MerchOrder[]

  @@unique([itemId, label]) // No duplicate variant labels within one item
  @@index([itemId])
}

// A single pre-order. orderRef is the human-facing tracking ID
// (MSC-MERCH-YYYY-NNNN). userId links to the account when the buyer was logged
// in; guest fields (studentName/studentId/email/gcashNumber) are always stored
// for display regardless of auth. Stock is not reserved until CONFIRMED.
model MerchOrder {
  id                 String                   @id @default(uuid())
  orderRef           String                   @unique // MSC-MERCH-YYYY-NNNN
  userId             String? // Set when placed by a logged-in Member/Applicant
  user               User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  studentName        String
  studentId          String? // QCU Student ID (guest-entered or from the account)
  email              String
  gcashNumber        String? // Payer's GCash number — recorded for reference only
  variantId          String
  variant            MerchVariant             @relation(fields: [variantId], references: [id])
  quantity           Int
  amount             Decimal                  @db.Decimal(10, 2) // Snapshot of price × quantity at order time
  status             MerchOrderStatus         @default(AWAITING_PAYMENT)
  rejectionReason    MerchRejectionReason? // Latest rejection reason (denormalised from the newest submission)
  financeNote        String?                  @db.Text // Free-text for OTHER rejections / cancellation notes
  // Notification tracking (Module 04 §7b) — records the latest status-email
  // attempt so Finance can tell "emailed" from "silently failed" and find
  // stale orders (e.g. un-notified REFUND_PENDING / AMOUNT_MISMATCH).
  lastNotifiedAt     DateTime? // Time of the most recent status-email attempt (ok or not)
  lastNotificationOk Boolean? // Whether that most recent attempt actually sent
  notificationCount  Int                      @default(0) // Count of successful status emails
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  proofSubmissions   PaymentProofSubmission[]
  refund             MerchRefund? // Present once a refund is recorded (REFUNDED)

  @@index([status])
  @@index([email])
  @@index([studentId])
  @@index([userId])
}

// Append-only audit trail of every payment-proof submission attempt (Flow 3–4).
// referenceNumber is indexed but NOT unique: a duplicate is the very thing we
// must record, so a unique constraint would block the write that logs the
// violation. Duplicate detection is enforced in application code across all
// orders and submissions.
model PaymentProofSubmission {
  id              String                @id @default(uuid())
  orderId         String
  order           MerchOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  screenshotPath  String // Blob path/URL to the uploaded GCash screenshot
  referenceNumber String // 13-digit GCash reference number submitted by the student
  result          PaymentProofResult
  // Officer verification decision for THIS attempt (Module 04 §7b). Preserves a
  // per-attempt history so a resubmission never erases why an earlier attempt
  // was rejected. The order's status/rejectionReason denormalise the latest.
  officerDecision PaymentProofDecision  @default(PENDING)
  rejectionReason MerchRejectionReason? // Officer's reason when officerDecision = REJECTED
  financeNote     String?               @db.Text // Free-text note for OTHER rejections
  reviewedById    String? // Actor (user id) who reviewed this attempt
  reviewedAt      DateTime? // When the officer decided on this attempt
  createdAt       DateTime              @default(now())

  @@index([orderId])
  @@index([referenceNumber])
}

// Offline refund record for an oversold/cancelled order (Module 04 §7a).
// One refund per order. Kept as a dedicated record (rather than a note on the
// order) so refund amount, method, and reference are transparently auditable.
model MerchRefund {
  id              String            @id @default(uuid())
  orderId         String            @unique
  order           MerchOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount          Decimal           @db.Decimal(10, 2) // Amount refunded (≤ order.amount)
  method          MerchRefundMethod
  referenceNumber String? // GCash/transfer reference of the refund, when applicable
  note            String?           @db.Text // Optional context (e.g. partial refund reason)
  processedById   String? // Actor (user id) who recorded the refund — head-only
  processedAt     DateTime          @default(now())
}
